<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TnA.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#0D0F15" />
          <SolidColorBrush x:Key="CardBackground" Color="#171B25" />
          <SolidColorBrush x:Key="CardBackground2" Color="#1E2330" />
          <SolidColorBrush x:Key="CardBorder" Color="#2A3040" />
          <SolidColorBrush x:Key="MutedText" Color="#8D95A8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F4F5FA" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBackground2" Color="#F3F4F9" />
          <SolidColorBrush x:Key="CardBorder" Color="#DDE1EC" />
          <SolidColorBrush x:Key="MutedText" Color="#646D82" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#FF4D8D" />
        <GradientStop Offset="1" Color="#7C5CFF" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="OkBrush" Color="#34D399" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
      <SolidColorBrush x:Key="ErrBrush" Color="#F87171" />
      <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />

      <StreamGeometry x:Key="IconPlay">M8,5.5 L8,18.5 C8,19.3 8.9,19.8 9.5,19.4 L19.9,12.9 C20.5,12.5 20.5,11.6 19.9,11.2 L9.5,4.6 C8.9,4.2 8,4.7 8,5.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPause">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3,7.5 C3,6.1 4.1,5 5.5,5 H9 L11,7 H18.5 C19.9,7 21,8.1 21,9.5 V16.5 C21,17.9 19.9,19 18.5,19 H5.5 C4.1,19 3,17.9 3,16.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M9,3 H15 L16,5 H20 V7 H4 V5 H8 Z M6,9 H18 L17,20 C17,21.1 16.1,22 15,22 H9 C7.9,22 7,21.1 7,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconGear">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M10.9,2 H13.1 L13.6,4.7 C14.3,4.9 15,5.3 15.6,5.7 L18.2,4.7 L19.3,6.6 L17.2,8.4 C17.4,9.1 17.4,9.9 17.2,10.6 L19.3,12.4 L18.2,14.3 L15.6,13.3 C15,13.7 14.3,14.1 13.6,14.3 L13.1,17 H10.9 L10.4,14.3 C9.7,14.1 9,13.7 8.4,13.3 L5.8,14.3 L4.7,12.4 L6.8,10.6 C6.6,9.9 6.6,9.1 6.8,8.4 L4.7,6.6 L5.8,4.7 L8.4,5.7 C9,5.3 9.7,4.9 10.4,4.7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMoon">M20,14.5 A8.5,8.5 0 0 1 9.5,4 A8.5,8.5 0 1 0 20,14.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLog">M6,3 H15 L20,8 V19 C20,20.1 19.1,21 18,21 H6 C4.9,21 4,20.1 4,19 V5 C4,3.9 4.9,3 6,3 Z M8,12 V14 H16 V12 Z M8,16 V18 H14 V16 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTerm">M4,4 H20 C21.1,4 22,4.9 22,6 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 V6 C2,4.9 2.9,4 4,4 Z M6.3,8.3 L5,9.6 L7.4,12 L5,14.4 L6.3,15.7 L10,12 Z M11,15 V17 H18 V15 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRedo">M12,5 A7,7 0 1 0 18.9,13.2 H16.8 A5,5 0 1 1 12,7 C13.4,7 14.6,7.6 15.5,8.5 L13,11 H20 V4 L17.4,6.6 A7,7 0 0 0 12,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconUp">M12,7 L6,13 L7.4,14.4 L12,9.8 L16.6,14.4 L18,13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDown">M12,17 L18,11 L16.6,9.6 L12,14.2 L7.4,9.6 L6,11 Z</StreamGeometry>
      <StreamGeometry x:Key="IconFilm">M5,4 H19 C20.1,4 21,4.9 21,6 V18 C21,19.1 20.1,20 19,20 H5 C3.9,20 3,19.1 3,18 V6 C3,4.9 3.9,4 5,4 Z M5,7 V9 H7 V7 Z M17,7 V9 H19 V7 Z M5,11 V13 H7 V11 Z M17,11 V13 H19 V11 Z M5,15 V17 H7 V15 Z M17,15 V17 H19 V15 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#7C5CFF" />
        <ColorPaletteResources x:Key="Dark" Accent="#9B7CFF" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackground}" />
      <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.job.running">
      <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.job.selected">
      <Setter Property="BorderBrush" Value="#9B7CFF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource CardBackground2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="Border.chip.hw TextBlock">
      <Setter Property="Foreground" Value="#9B7CFF" />
    </Style>
    <Style Selector="Border.chip.bit TextBlock">
      <Setter Property="Foreground" Value="#FF4D8D" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#EF4444" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="MinHeight" Value="8" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
    </Style>
    <Style Selector="ProgressBar.done">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="ProgressBar.error">
      <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
    </Style>
    <Style Selector="ProgressBar.paused">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>
  </Application.Styles>
</Application>
